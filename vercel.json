{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/design-system",
      "destination": "/kihon",
      "permanent": true
    },
    {
      "source": "/en/design-system",
      "destination": "/en/kihon",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|favicon\\.svg|og-image\\.png|robots\\.txt|sitemap\\.xml|curriculo/).*)",
      "destination": "/index.html"
    }
  ]
}
